{
  "description": "herdr-subagents: the mod (the subagent tool, the fleet status line and wake) and the SessionStart onboarding injection.",
  "modules": ["./register.js"],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/onboarding.sh"]
          }
        ]
      }
    ]
  }
}
