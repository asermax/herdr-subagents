{
  "name": "herdr-subagents",
  "version": "0.1.0",
  "private": true,
  "description": "Coding-agent subagents as herdr tabs.",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "bin": {
    "herdr-helper": "dist/helper/cli.js"
  },
  "scripts": {
    "build": "npm run build:helper && npm run build:skills",
    "build:helper": "tsc",
    "build:skills": "node --experimental-strip-types build/build.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^22.0.0",
    "citty": "^0.2.2",
    "esbuild": "^0.28.1",
    "semantic-release": "^25.0.9",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true
  }
}
