{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "types": ["vitest/globals", "node"]
  },
  "include": ["src/**/*.ts", "build/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist", "build/out"]
}
